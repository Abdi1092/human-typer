
{
  "manifest_version": 3,
  "name": "Human Typer",
  "version": "2.0.0",
  "description": "A local, user-controlled typing simulation workspace.",
  "permissions": [
    "sidePanel",
    "storage",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Human Typer V2"
  }
}
