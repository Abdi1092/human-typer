
{
  "manifest_version": 3,
  "name": "Human Typer",
  "version": "1.0.0",
  "description": "A transparent, user-controlled typing simulator.",
  "permissions": [
    "sidePanel",
    "storage",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Human Typer"
  }
}
